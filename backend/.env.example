# ---- Application ----
APP_NAME="Enterprise HR Portal API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Security ----
SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database ----
POSTGRES_USER=hrms_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=hrms_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hrms_user:change-this-password@postgres:5432/hrms_db

# ---- Redis (session/rate-limit store) ----
REDIS_URL=redis://redis:6379/0

# ---- CORS ----
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ---- Auth / MFA ----
MFA_ISSUER_NAME="Enterprise HR Portal"
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CAPTCHA_AFTER_ATTEMPTS=3

# ---- Email (OTP / notifications) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change-this
SMTP_FROM="Enterprise HR Portal <no-reply@example.com>"
