                {row.manager_comment && (
                  <p className="mt-2 text-[11px] text-amber-700">
                    Manager: {row.manager_comment}
                  </p>
                )}
                {row.hr_comment && (
                  <p className="mt-1 text-[11px] text-amber-700">
