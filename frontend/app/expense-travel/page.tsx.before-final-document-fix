function getCurrentEmployeeId(): string | null {
  try {
    const raw =
      localStorage.getItem("user") ||
      localStorage.getItem("currentUser") ||
      localStorage.getItem("auth_user");

    if (!raw) return null;

    const user = JSON.parse(raw);

    return (
      user.employee_id ||
      user.employeeId ||
      user.employee?.id ||
      null
    );
  } catch {
    return null;
  }
}

  Expense,
  Travel,
